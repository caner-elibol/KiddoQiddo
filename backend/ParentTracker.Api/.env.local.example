# Backend ayarları appsettings.json'dan okunur; bu dosya otomatik yüklenmez.
# Değerleri geçersiz kılmak için ortam değişkeni olarak ver ya da user-secrets kullan:
#
#   dotnet user-secrets init --project ParentTracker.Api
#   dotnet user-secrets set "Jwt:Secret" "<en az 32 karakterlik gizli anahtar>" --project ParentTracker.Api
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Host=localhost;Port=5438;Database=parent_tracker;Username=postgres;Password=postgres_dev_password" --project ParentTracker.Api
#
# Ortam değişkeni karşılıkları ("__" iç içe anahtarı ayırır):

ConnectionStrings__DefaultConnection=Host=localhost;Port=5438;Database=parent_tracker;Username=postgres;Password=postgres_dev_password
Jwt__Secret=change_this_to_a_random_secret_of_at_least_32_chars
Jwt__Issuer=LittleSteps
Jwt__Audience=LittleStepsApp
Jwt__AccessTokenExpiryMinutes=60
