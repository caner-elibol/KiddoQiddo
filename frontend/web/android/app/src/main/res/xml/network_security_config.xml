<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config for KiddoQiddo

  Allows cleartext (HTTP) traffic to localhost during development.
  Production builds should point to HTTPS API only.
-->
<network-security-config>
    <!-- Allow cleartext to local dev server only -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- All other traffic must use HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
